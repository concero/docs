{
	"name": "docs",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vocs dev",
		"build": "vocs build",
		"preview": "vocs preview",
		"format:fix": "prettier --write . --ignore-path .prettierignore"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@types/react": "latest",
		"@vercel/og": "0.6.2",
		"react": "latest",
		"react-dom": "latest",
		"typescript": "latest",
		"vocs": "latest"
	},
	"devDependencies": {
		"mermaid": "10.9.1",
		"prettier": "3.3.3",
		"vitepress-plugin-mermaid": "2.0.16",
		"husky": "9.1.7"
	},
	"husky": {
		"hooks": {
			"pre-commit": "npm run format:fix && npm run build"
		}
	}
}
